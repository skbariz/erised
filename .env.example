# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Where Parquet market data is stored (optional; defaults to ./data).
# ERISED_DATA_DIR=/path/to/erised-data

# Required by `erised data fundamentals` (SEC EDGAR fair-access policy).
SEC_EDGAR_USER_AGENT="your-project you@example.com"

# Alpaca paper-trading keys for erised.execution.paper_trader (optional).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
